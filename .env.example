# OpenAI API Configuration
# 获取方式：从你的 LLM API 提供商获取
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4

# DeepXiv API Configuration
# 获取方式：访问 https://deepxiv.com 注册并获取 token
DEEPXIV_TOKEN=your_deepxiv_token_here

# Search Configuration
# 搜索查询关键词，用于在 arXiv 上搜索论文
QUERY="multimodal LVLM MLLM"

# 我的研究方向：用于判断论文相关性、启发和如何指导新论文选题。
# 留空时默认使用 QUERY。
RESEARCH_FOCUS="multimodal LVLM MLLM"

# 可选：从 txt 文件批量读取 arXiv ID / URL。设置后会跳过关键词搜索。
# 支持混合格式：2605.08389、2605.08389v2、https://arxiv.org/abs/2605.08389
ARXIV_IDS_FILE=

# 搜索论文数量限制
LIMIT=5

# 论文发布日期起始点（格式：YYYY-MM-DD）
DATE_FROM=2025-01-01

# arXiv 分类，多个分类用逗号分隔
# 常用分类：
# - cs.CV: Computer Vision
# - cs.CL: Computation and Language (NLP)
# - cs.AI: Artificial Intelligence
# - cs.LG: Machine Learning
# - cs.CR: Cryptography and Security
CATEGORIES=cs.CV,cs.CL

# Processing Configuration
# 并行处理的线程数（建议 4-16，根据机器性能和 API 限流调整）
MAX_WORKERS=8

# 是否下载 PDF 文件（true/false）
DOWNLOAD_PDF=true

# 是否从 PDF 中提取图片（true/false）
EXTRACT_FIGURES=true

# 是否生成 30min deep note / Whether to generate 30min deep note (true/false)
GENERATE_DEEP_NOTE=false

# 是否使用 LaTeX 源码提取图片 / Whether to use LaTeX source for figure extraction (true/false)
USE_LATEX_SOURCE=true

# 是否生成图表上下文分析 / Whether to generate figure context analysis (true/false)
ANALYZE_FIGURES=true

# Conference Search Configuration (tools/conference_search.py)
# 本地 arXiv 元数据快照路径（推荐 Kaggle Cornell-University/arxiv 数据集）
# Local arXiv metadata snapshot path (Kaggle Cornell-University/arxiv dataset recommended)
ARXIV_METADATA_FILE=

# OpenAlex polite-pool 邮箱（使用 openalex 后端时需要）
# OpenAlex polite-pool email (required for openalex backend)
OPENALEX_MAILTO=paper_agent@example.com

# 飞书 Webhook URL（用于 refresh_arxiv_snapshot.py 的成功/失败通知，可选）
# Feishu webhook URL for refresh_arxiv_snapshot.py notifications (optional)
FEISHU_WEBHOOK_URL=

# kaggle CLI 绝对路径（用于 refresh_arxiv_snapshot.py，cron 环境需要）
# Absolute path to kaggle CLI binary (needed for cron where PATH is minimal)
# 获取方式：运行 `which kaggle` 获取路径
KAGGLE_BIN=
